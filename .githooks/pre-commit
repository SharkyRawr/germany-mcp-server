#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
if ! command -v black >/dev/null 2>&1; then
    echo "Black is required on PATH. Install it system-wide before committing." >&2
    exit 1
fi

black .
if ! git diff --quiet -- '*.py' '*.pyi'; then
    echo "Python files have unstaged changes. Review and stage them, then commit again." >&2
    exit 1
fi
