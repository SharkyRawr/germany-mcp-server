#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required on PATH. Install it before committing." >&2
    exit 1
fi

uvx --python 3.15 black .
if ! git diff --quiet -- '*.py' '*.pyi'; then
    echo "Python files have unstaged changes. Review and stage them, then commit again." >&2
    exit 1
fi
